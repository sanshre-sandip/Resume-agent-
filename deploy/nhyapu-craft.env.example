# Install as /etc/nhyapu-craft.env and replace the local development secret.
APP_ENV=production
PUBLIC_BASE_URL=https://craft.nhyapu.space
SESSION_SECRET=local-development-only-change-this-secret
SESSION_COOKIE_NAME=nhyapu_session
SESSION_MAX_AGE_SECONDS=604800
REQUIRE_EMAIL_VERIFICATION=true
CORS_ORIGINS=https://craft.nhyapu.space
DATA_DIR=/var/lib/nhyapu-craft/data
GENERATED_DIR=/var/lib/nhyapu-craft/generated
UPLOAD_DIR=/var/lib/nhyapu-craft/uploads
LOG_DIR=/var/lib/nhyapu-craft/logs

# Brevo SMTP: use its SMTP login and SMTP key, plus a verified sender address.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional Google OAuth callback registered with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://craft.nhyapu.space/api/auth/google/callback

# Optional AI providers; credentials stay on the server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
