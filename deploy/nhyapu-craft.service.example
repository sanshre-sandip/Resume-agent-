[Unit]
Description=Nhyapu Craft FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nhyapu-craft
Group=nhyapu-craft
WorkingDirectory=/opt/nhyapu-craft
EnvironmentFile=/etc/nhyapu-craft.env
ExecStart=/opt/nhyapu-craft/.venv/bin/uvicorn --app-dir /opt/nhyapu-craft/resume_creator/backend app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nhyapu-craft

[Install]
WantedBy=multi-user.target
