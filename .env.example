# Public site and runtime
APP_NAME=Nhyapu Craft
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8001
SESSION_SECRET=local-development-only-change-this-secret
SESSION_COOKIE_NAME=nhyapu_session
SESSION_MAX_AGE_SECONDS=604800
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001,https://craft.nhyapu.space
REQUIRE_EMAIL_VERIFICATION=false
DATA_DIR=./data
GENERATED_DIR=./resume_creator/generated
UPLOAD_DIR=./resume_creator/uploads
LOG_DIR=./resume_creator/logs

# Brevo transactional email. Use the SMTP login and SMTP key from Brevo (not an API key).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional Google OpenID Connect login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/auth/google/callback

# Optional server-managed AI provider credentials (never put these in frontend code)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
